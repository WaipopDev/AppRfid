<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5"
    android:padding="0dp">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#172D53"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:layout_marginBottom="10dp"/>

    <!-- Content Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/headerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ข้อมูลการจัดส่งผ้า"
            android:textColor="#172D53"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLoadData"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="โหลดข้อมูล"
            android:backgroundTint="#28a745"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"/>
    </LinearLayout>

    <!-- Form Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="15dp"
        android:paddingRight="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. จุดส่งผ้า -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="20dp"
                android:layout_marginBottom="15dp"
                android:elevation="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. จุดส่งผ้า"
                    android:textColor="#172D53"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <Spinner
                    android:id="@+id/spinnerWarehouse"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

            <!-- 2. จุดรับผ้าเข้าหน่วยงาน -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="20dp"
                android:layout_marginBottom="15dp"
                android:elevation="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. จุดรับผ้าเข้าหน่วยงาน"
                    android:textColor="#172D53"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <Spinner
                    android:id="@+id/spinnerDepartment"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

            <!-- 3. รอบการส่งผ้า -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="20dp"
                android:layout_marginBottom="15dp"
                android:elevation="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. รอบการส่งผ้า"
                    android:textColor="#172D53"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <RadioGroup
                    android:id="@+id/radioGroupSendType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioSendStandard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ปกติ"
                        android:textColor="#333"
                        android:textSize="16sp"
                        android:padding="10dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:layout_marginBottom="5dp" />

                    <RadioButton
                        android:id="@+id/radioSendSupplement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="เสริม"
                        android:textColor="#333"
                        android:textSize="16sp"
                        android:padding="10dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:layout_marginBottom="5dp" />

                    <RadioButton
                        android:id="@+id/radioSendUrgent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ด่วน"
                        android:textColor="#333"
                        android:textSize="16sp"
                        android:padding="10dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:layout_marginBottom="5dp" />

                    <RadioButton
                        android:id="@+id/radioSendBeforeWashing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="รอบ2"
                        android:textColor="#333"
                        android:textSize="16sp"
                        android:padding="10dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:layout_marginBottom="5dp" />

                </RadioGroup>

            </LinearLayout>

            <!-- 4. หมายเหตุ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="20dp"
                android:layout_marginBottom="15dp"
                android:elevation="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. หมายเหตุ"
                    android:textColor="#172D53"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/editTextRemark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="กรอกหมายเหตุ (ถ้ามี)"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:maxLines="5"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Footer Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="ย้อนกลับ"
            android:backgroundTint="#6c757d"
            android:textColor="@android:color/white"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"/>

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="ยืนยัน"
            android:backgroundTint="#172D53"
            android:textColor="@android:color/white"
            android:paddingLeft="25dp"
            android:paddingRight="25dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"/>

    </LinearLayout>

</LinearLayout>
